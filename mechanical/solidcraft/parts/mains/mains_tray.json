{
  "format": "solidcraft/53",
  "name": "mains_tray",
  "units": "mm",
  "params": [
    {
      "name": "tray_t",
      "expr": "1.5 mm",
      "unit": "mm",
      "comment": "5052 / 1050 aluminium sheet thickness; 1.0 to 2.0 mm",
      "model": false
    },
    {
      "name": "bend_r",
      "expr": "1.5 mm",
      "unit": "mm",
      "comment": "inside bend radius (1 t, the least 5052-H32 takes at 1.5 mm); 1 to 3 mm",
      "model": false
    },
    {
      "name": "psu_w",
      "expr": "97 mm",
      "unit": "mm",
      "comment": "LRS-150-36 width; fixed by the supply",
      "model": false
    },
    {
      "name": "tray_side_gap",
      "expr": "2 mm",
      "unit": "mm",
      "comment": "PSU side -> tray wall; 1 to 5 mm",
      "model": false
    },
    {
      "name": "tray_half",
      "expr": "psu_w/2 + tray_side_gap + tray_t",
      "unit": "mm",
      "comment": "half outside width of the tray (derived)",
      "model": false
    },
    {
      "name": "tray_bot",
      "expr": "-153.20883080499217 mm",
      "unit": "mm",
      "comment": "world y of the tray floor's underside (from the clutch layout); fixed by feed_unit.py",
      "model": false
    },
    {
      "name": "tray_low",
      "expr": "32.5 mm",
      "unit": "mm",
      "comment": "outside height of the low walls over the PSU: psu_h + 1 + tray_t; 32 to 40 mm",
      "model": false
    },
    {
      "name": "term_zone_rise",
      "expr": "10 mm",
      "unit": "mm",
      "comment": "walls, end face and lid this much higher over the terminal/inlet zone; 5 to 15 mm",
      "model": false
    },
    {
      "name": "tray_w0",
      "expr": "63 mm",
      "unit": "mm",
      "comment": "W of the plate's outer face, where the floor starts; fixed by feed_unit.py",
      "model": false
    },
    {
      "name": "wall_w0",
      "expr": "tray_w0 + 12 mm",
      "unit": "mm",
      "comment": "W where the side walls start (past the belt-tension block)",
      "model": false
    },
    {
      "name": "term_w0",
      "expr": "223 mm",
      "unit": "mm",
      "comment": "W where the raised terminal/inlet zone starts (psu_w0 + psu_l - 18)",
      "model": false
    },
    {
      "name": "tray_w1",
      "expr": "307.5 mm",
      "unit": "mm",
      "comment": "W of the end face's outside (inlet panel); 280 to 320 mm",
      "model": false
    },
    {
      "name": "lid_flange",
      "expr": "10 mm",
      "unit": "mm",
      "comment": "inward-folded lid flanges carrying the M3 rivnuts; 8 to 14 mm",
      "model": false
    },
    {
      "name": "relief",
      "expr": "bend_r + tray_t + 0.5 mm",
      "unit": "mm",
      "comment": "bend reliefs reach 0.5 past the bend's tangent line (derived)",
      "model": false
    },
    {
      "name": "tab_x",
      "expr": "34 mm",
      "unit": "mm",
      "comment": "x of the two floor tabs (M4 into the plate); 25 to 40 mm",
      "model": false
    },
    {
      "name": "bend_allow",
      "expr": "pi/2*(bend_r + 0.33*tray_t)",
      "unit": "mm",
      "comment": "bend allowance per 90-degree bend at K 0.33 (derived; keep the 0.33 equal to the rule's K-factor)",
      "model": false
    },
    {
      "name": "bend_ded",
      "expr": "2*(bend_r + tray_t) - bend_allow",
      "unit": "mm",
      "comment": "bend deduction per 90-degree bend (derived)",
      "model": false
    },
    {
      "name": "corner_relief_r",
      "expr": "bend_allow/sqrt(2) + 0.5 mm",
      "unit": "mm",
      "comment": "round relief where the floor's wall and end-face bends cross: over both bend zones (derived)",
      "model": false
    },
    {
      "name": "d13",
      "expr": "corner_relief_r",
      "unit": "mm",
      "model": true
    },
