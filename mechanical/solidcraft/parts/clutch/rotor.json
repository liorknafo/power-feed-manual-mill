{
  "format": "solidcraft/53",
  "name": "rotor",
  "units": "mm",
  "params": [
    {
      "name": "housing_len",
      "expr": "20 mm",
      "unit": "mm",
      "comment": "Field housing length (motor face to housing pole face); sets where the rotor sits; 15..30 mm",
      "model": false
    },
    {
      "name": "face_gap",
      "expr": "0.3 mm",
      "unit": "mm",
      "comment": "Axial gap housing pole face -> rotor back face; 0.2..0.5 mm",
      "model": false
    },
    {
      "name": "face_t",
      "expr": "5.6 mm",
      "unit": "mm",
      "comment": "Rotor pole-face disc thickness; 4..8 mm",
      "model": false
    },
    {
      "name": "rotor_od",
      "expr": "76 mm",
      "unit": "mm",
      "comment": "Rotor OD; 2*tooth_r_out (the teeth run out at the OD)",
      "model": false
    },
    {
      "name": "hub_od",
      "expr": "18.6 mm",
      "unit": "mm",
      "comment": "Rotor hub OD (runs in the housing bore with 0.3 radial gap); shaft_d+6..bore_d-0.6 mm",
      "model": false
    },
    {
      "name": "hub_start",
      "expr": "2.2 mm",
      "unit": "mm",
      "comment": "Hub's motor-side end above the motor face (clears the 1.6 pilot); 1.8..4 mm",
      "model": false
    },
    {
      "name": "shaft_d",
      "expr": "10 mm",
      "unit": "mm",
      "comment": "Motor shaft diameter (bore is shaft_d + 0.01, H7 for Loctite); 8..12 mm",
      "model": false
    },
    {
      "name": "shaft_len",
      "expr": "21 mm",
      "unit": "mm",
      "comment": "MEASURED motor shaft length beyond the flange face (sets the 0.3 face gap); bore depth = shaft_len - hub_start; 18..24 mm",
      "model": false
    },
    {
      "name": "slot_r_in",
      "expr": "19 mm",
      "unit": "mm",
      "comment": "Banana slots' inner radius (over the coil: separates inner and outer poles); 17..slot_r_out-2 mm",
      "model": false
    },
    {
      "name": "slot_r_out",
      "expr": "22 mm",
      "unit": "mm",
      "comment": "Banana slots' outer radius; slot_r_in+2..25 mm",
      "model": false
    },
    {
      "name": "slot_count",
      "expr": "3",
      "unit": "",
      "comment": "Number of banana slots, whole number 2..6",
      "model": false
    },
    {
      "name": "slot_span_deg",
      "expr": "112 deg",
      "unit": "deg",
      "comment": "Angular span of each slot over its full-round ends; bridges = 360/slot_count - span; 60..(360/slot_count - 4) deg",
      "model": false
    },
    {
      "name": "teeth",
      "expr": "30",
      "unit": "",
      "comment": "Number of radial face teeth, whole number 12..60 (the armature must match)",
      "model": false
    },
    {
      "name": "tooth_r_in",
      "expr": "32 mm",
      "unit": "mm",
      "comment": "Tooth band inner radius; 28..tooth_r_out-3 mm",
      "model": false
    },
    {
      "name": "tooth_r_out",
      "expr": "rotor_od / 2",
      "unit": "mm",
      "comment": "Tooth band outer radius (= rotor OD/2)",
      "model": false
    },
    {
      "name": "tooth_h",
      "expr": "0.9 mm",
      "unit": "mm",
      "comment": "Full (un-truncated) tooth height, root to root of the mating parts; 0.5..2 mm",
      "model": false
    },
    {
      "name": "tip_trunc",
      "expr": "0.1 mm",
      "unit": "mm",
      "comment": "Tips cut this much lower (the flanks carry the load); 0..tooth_h/3",
      "model": false
    },
    {
      "name": "root_relief",
      "expr": "0.5 mm",
      "unit": "mm",
      "comment": "Root floor this far below the root level (flanks continue down to it); 0.2..1 mm",
      "model": false
    },
    {
      "name": "tooth_runout",
      "expr": "1 mm",
      "unit": "mm",
      "comment": "Turned run-out groove inside the teeth (tool clearance); 0.5..2 mm",
      "model": false
    },
    {
      "name": "flank_deg",
      "expr": "30 deg",
      "unit": "deg",
      "comment": "Flank angle from the axis (planar flanks, 60-degree chamfer mill); 20..40 deg",
      "model": false
    },
    {
      "name": "root_drop",
      "expr": "0.5 mm",
      "unit": "mm",
      "comment": "Rotor root level (where the flanks of the mating teeth meet) below the rotor pole face; 0.3..1 mm",
      "model": false
    },
    {
      "name": "z_face_back",
      "expr": "housing_len + face_gap",
      "unit": "mm",
      "comment": "Derived: rotor disc's motor-side face",
      "model": false
    },
    {
      "name": "z_pole",
      "expr": "z_face_back + face_t",
      "unit": "mm",
      "comment": "Derived: rotor pole face",
      "model": false
    },
    {
      "name": "z_root",
      "expr": "z_pole - root_drop",
      "unit": "mm",
      "comment": "Derived: rotor tooth root level",
      "model": false
    },
    {
      "name": "z_pitch",
      "expr": "z_root + tooth_h / 2",
      "unit": "mm",
      "comment": "Derived: pitch plane (tooth width = gap width = half a pitch there)",
      "model": false
    },
    {
      "name": "z_floor",
      "expr": "z_root - root_relief",
      "unit": "mm",
      "comment": "Derived: root floor of the tooth band",
      "model": false
    },
    {
      "name": "z_tip",
      "expr": "z_root + tooth_h - tip_trunc",
      "unit": "mm",
      "comment": "Derived: truncated tooth tips",
      "model": false
    },
    {
      "name": "d2",
      "expr": "hub_od",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d5",
      "expr": "rotor_od",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d8",
      "expr": "tooth_r_out + 1 mm",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d9",
      "expr": "tooth_r_in - tooth_runout",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d12",
      "expr": "tooth_r_out",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d13",
      "expr": "tooth_r_in",
      "unit": "mm",
      "model": true
    },
    {
      "name": "slot_trim",
      "expr": "(slot_r_out - slot_r_in) / (slot_r_out + slot_r_in) * 180 deg / pi",
      "unit": "deg",
      "comment": "Derived: angle from each end of a slot's span to its round end's centre (half the width / centre radius, in radians)",
      "model": false
    },
    {
      "name": "d23",
      "expr": "(slot_r_in + slot_r_out) / 2",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d24",
      "expr": "slot_r_out - slot_r_in",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d25",
      "expr": "slot_span_deg - 2 * slot_trim",
      "unit": "deg",
      "model": true
    },
    {
      "name": "d26",
      "expr": "(slot_r_in + slot_r_out) / 2 * sin(slot_trim)",
      "unit": "mm",
      "model": true
    }
  ],
