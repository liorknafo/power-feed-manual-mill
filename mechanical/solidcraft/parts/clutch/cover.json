{
  "format": "solidcraft/53",
  "name": "cover",
  "units": "mm",
  "params": [
    {
      "name": "housing_od",
      "expr": "80 mm",
      "unit": "mm",
      "comment": "field housing OD = spigot bore (slide fit)",
      "model": false
    },
    {
      "name": "cover_wall",
      "expr": "4 mm",
      "unit": "mm",
      "comment": "radial wall over the housing (>= 3, carries the M4 countersinks)",
      "model": false
    },
    {
      "name": "housing_len",
      "expr": "20 mm",
      "unit": "mm",
      "comment": "field housing length: the shoulder sits on its rim at z = housing_len",
      "model": false
    },
    {
      "name": "cover_spigot_z",
      "expr": "2 mm",
      "unit": "mm",
      "comment": "clutch frame: start of the spigot over the housing (0.5 .. housing_len - 10)",
      "model": false
    },
    {
      "name": "cover_cavity_d",
      "expr": "78 mm",
      "unit": "mm",
      "comment": "cavity bore: clears the Ø76 rotor / armature (< housing_od)",
      "model": false
    },
    {
      "name": "z_front",
      "expr": "54.85 mm",
      "unit": "mm",
      "comment": "clutch frame: inside face of the front wall (hub top + 3)",
      "model": false
    },
    {
      "name": "cover_front_t",
      "expr": "8 mm",
      "unit": "mm",
      "comment": "front wall thickness: carries the 4 M5 module bolts (> 6)",
      "model": false
    },
    {
      "name": "bearing_od",
      "expr": "28 mm",
      "unit": "mm",
      "comment": "6001 bearing OD = straight-through bore",
      "model": false
    },
    {
      "name": "bearing_w",
      "expr": "8 mm",
      "unit": "mm",
      "comment": "6001 bearing width",
      "model": false
    },
    {
      "name": "bearing_gap",
      "expr": "8 mm",
      "unit": "mm",
      "comment": "gap between the two 6001s (spacer tube length = bearing_gap + 4.8)",
      "model": false
    },
    {
      "name": "boss_len",
      "expr": "2*bearing_w + bearing_gap + 4 mm",
      "unit": "mm",
      "comment": "derived: bearing boss length beyond the front wall",
      "model": false
    },
    {
      "name": "boss_wall",
      "expr": "5 mm",
      "unit": "mm",
      "comment": "bearing boss wall around the bore (>= 3)",
      "model": false
    },
    {
      "name": "circlip_groove",
      "expr": "1.3 mm",
      "unit": "mm",
      "comment": "DIN 472-28 groove width",
      "model": false
    },
    {
      "name": "circlip_land",
      "expr": "2.1 mm",
      "unit": "mm",
      "comment": "material outside each bore groove (DIN 472-28 minimum edge margin)",
      "model": false
    },
    {
      "name": "groove_d",
      "expr": "29.4 mm",
      "unit": "mm",
      "comment": "DIN 472-28 groove diameter (> bearing_od)",
      "model": false
    },
    {
      "name": "cover_screws",
      "expr": "6",
      "unit": "",
      "comment": "whole number, 3 .. 8: radial M4 countersunk screws into the housing, the first at 30 deg",
      "model": false
    },
    {
      "name": "cover_screw_z",
      "expr": "(cover_spigot_z + housing_len)/2 + 1 mm",
      "unit": "mm",
      "comment": "derived: height of the radial M4 screws",
      "model": false
    },
    {
      "name": "cover_screw_d",
      "expr": "4.5 mm",
      "unit": "mm",
      "comment": "M4 clearance (ISO 273 medium)",
      "model": false
    },
    {
      "name": "cover_csk_d",
      "expr": "9.2 mm",
      "unit": "mm",
      "comment": "90 deg countersink diameter for ISO 10642 M4 (head Ø8.96)",
      "model": false
    },
    {
      "name": "cover_bolt_r",
      "expr": "36 mm",
      "unit": "mm",
      "comment": "module bolt radius, 4x M5 tapped into the front wall at 40/140/190/350 deg (bearing_od/2 + boss_wall + 4 .. housing_od/2 + cover_wall - 5)",
      "model": false
    },
    {
      "name": "drawbolt_depth",
      "expr": "15 mm",
      "unit": "mm",
      "comment": "M4 belt-tension drawbolt tap-drill depth, radial at +Y (< housing_od/2 + cover_wall - bearing_od/2 - 2)",
      "model": false
    },
    {
      "name": "d2",
      "expr": "housing_od + 2*cover_wall",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d3",
      "expr": "housing_od",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d6",
      "expr": "housing_od + 2*cover_wall",
      "unit": "mm",
      "model": true
    },
    {
