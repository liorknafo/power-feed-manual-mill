      "model": false
    },
    {
      "name": "cover_screw_depth",
      "expr": "9 mm",
      "unit": "mm",
      "comment": "Depth of the radial M4 tap-drill holes from the OD; 6..housing_od/2-coil_r_out-2 mm",
