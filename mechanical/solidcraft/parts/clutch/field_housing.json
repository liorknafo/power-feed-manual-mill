    {
      "name": "housing_od",
      "expr": "80 mm",
      "unit": "mm",
      "comment": "Field housing OD (the cover's spigot registers on it); 70..90 mm",
      "model": false
    },
    {
      "name": "housing_len",
      "expr": "20 mm",
      "unit": "mm",
      "comment": "Field housing length along the axis (motor flange face to pole face); 15..30 mm",
      "model": false
    },
    {
      "name": "back_plate",
      "expr": "5 mm",
      "unit": "mm",
      "comment": "Back plate thickness under the coil pocket; 3..8 mm",
      "model": false
    },
    {
      "name": "bore_d",
      "expr": "19.2 mm",
      "unit": "mm",
      "comment": "Inner pole bore (the rotor hub runs inside with 0.3 radial gap); 15..2*coil_r_in-3 mm",
      "model": false
    },
    {
      "name": "coil_r_in",
      "expr": "14 mm",
      "unit": "mm",
      "comment": "Coil pocket inner radius (inner pole wall); bore_d/2+1.5..coil_r_out-5 mm",
      "model": false
    },
    {
      "name": "coil_r_out",
      "expr": "27 mm",
      "unit": "mm",
      "comment": "Coil pocket outer radius; coil_r_in+5..28 mm (clear of the motor bolt counterbores)",
      "model": false
    },
    {
      "name": "edge_chamfer",
      "expr": "0.5 mm",
      "unit": "mm",
      "comment": "45-degree edge break on the front face's OD and bore; 0.2..1 mm",
      "model": false
    },
    {
      "name": "pilot_d",
      "expr": "38.1 mm",
      "unit": "mm",
      "comment": "Motor pilot diameter (the recess is 0.2 larger); NEMA 23: 38.1 mm",
      "model": false
    },
    {
      "name": "pilot_h",
      "expr": "1.6 mm",
      "unit": "mm",
      "comment": "Motor pilot height (the recess is 0.4 deeper); 1..3 mm",
      "model": false
    },
    {
      "name": "bolt_square",
      "expr": "47 mm",
      "unit": "mm",
      "comment": "Motor bolt square (23HS45 drawing: 47.0); 4x M5 through, counterbored from the front",
      "model": false
    },
    {
      "name": "bolt_cb_z",
      "expr": "6 mm",
      "unit": "mm",
      "comment": "Height of the M5 counterbore floor (head seat) above the motor face; 4..housing_len-4 mm",
      "model": false
    },
    {
      "name": "lead_d",
      "expr": "3.2 mm",
      "unit": "mm",
      "comment": "Coil lead exit hole diameter, also the width of the radial lead groove on the motor side; 2..4 mm",
      "model": false
    },
    {
      "name": "cover_spigot_z",
      "expr": "2 mm",
      "unit": "mm",
      "comment": "Where the cover's spigot over the housing OD starts (cover parameter); 0..housing_len-8 mm",
      "model": false
    },
    {
      "name": "cover_screw_z",
      "expr": "(cover_spigot_z + housing_len) / 2 + 1 mm",
      "unit": "mm",
