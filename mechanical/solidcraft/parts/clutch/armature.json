{
  "format": "solidcraft/53",
  "name": "armature",
  "units": "mm",
  "params": [
    {
      "name": "housing_len",
      "expr": "20 mm",
      "unit": "mm",
      "comment": "Field housing length (motor face to housing pole face); places the stack; 15..30 mm",
      "model": false
    },
    {
      "name": "face_gap",
      "expr": "0.3 mm",
      "unit": "mm",
      "comment": "Axial gap housing pole face -> rotor back face; 0.2..0.5 mm",
      "model": false
    },
    {
      "name": "face_t",
      "expr": "5.6 mm",
      "unit": "mm",
      "comment": "Rotor pole-face disc thickness; 4..8 mm",
      "model": false
    },
    {
      "name": "engaged_gap",
      "expr": "0.15 mm",
      "unit": "mm",
      "comment": "Pole-face gap rotor -> armature when meshed (engaged); 0.05..0.3 mm",
      "model": false
    },
    {
      "name": "rotor_od",
      "expr": "76 mm",
      "unit": "mm",
      "comment": "Armature OD (= rotor OD and hub flange OD); 2*tooth_r_out",
      "model": false
    },
    {
      "name": "armature_t",
      "expr": "6 mm",
      "unit": "mm",
      "comment": "Armature thickness; 4..10 mm",
      "model": false
    },
    {
      "name": "armature_bore",
      "expr": "11.5 mm",
      "unit": "mm",
      "comment": "Armature bore (clears the 10 mm motor shaft / screw head); 10.5..2*(pin_r-pin_d)-2 mm",
      "model": false
    },
    {
      "name": "pin_r",
      "expr": "21 mm",
      "unit": "mm",
      "comment": "Drive pin circle radius (between the pole rings r 15 / r 27); 16..26 mm",
      "model": false
    },
    {
      "name": "pin_d",
      "expr": "6 mm",
      "unit": "mm",
      "comment": "Drive pin diameter (6 h6 silver steel); 4..8 mm",
      "model": false
    },
    {
      "name": "pin_glue",
      "expr": "0.17 mm",
      "unit": "mm",
      "comment": "Diametral glue gap for the bonded pins (Loctite 680 fills up to 0.38); 0.05..0.3 mm",
      "model": false
    },
    {
      "name": "teeth",
      "expr": "30",
      "unit": "",
      "comment": "Number of radial face teeth, whole number 12..60 (the rotor must match)",
      "model": false
    },
    {
      "name": "tooth_r_in",
      "expr": "32 mm",
      "unit": "mm",
      "comment": "Tooth band inner radius; 28..tooth_r_out-3 mm",
      "model": false
    },
    {
      "name": "tooth_r_out",
      "expr": "rotor_od / 2",
      "unit": "mm",
      "comment": "Tooth band outer radius (= armature OD/2)",
      "model": false
    },
    {
      "name": "tooth_h",
      "expr": "0.9 mm",
      "unit": "mm",
      "comment": "Full (un-truncated) tooth height, root to root of the mating parts; 0.5..2 mm",
      "model": false
    },
    {
      "name": "tip_trunc",
      "expr": "0.1 mm",
      "unit": "mm",
      "comment": "Tips cut this much shorter (the flanks carry the load); 0..tooth_h/3",
      "model": false
    },
    {
      "name": "root_relief",
      "expr": "0.5 mm",
      "unit": "mm",
      "comment": "Root floor this far beyond the root level (flanks continue to it); 0.2..1 mm",
      "model": false
    },
    {
      "name": "tooth_runout",
      "expr": "1 mm",
      "unit": "mm",
      "comment": "Turned run-out groove inside the teeth (tool clearance); 0.5..2 mm",
      "model": false
    },
    {
      "name": "flank_deg",
      "expr": "30 deg",
      "unit": "deg",
      "comment": "Flank angle from the axis (planar flanks, 60-degree chamfer mill); 20..40 deg",
      "model": false
    },
    {
      "name": "root_drop",
      "expr": "0.5 mm",
      "unit": "mm",
      "comment": "Rotor root level below the rotor pole face (the armature's root is tooth_h above it); 0.3..1 mm",
      "model": false
    },
    {
      "name": "z_pole",
      "expr": "housing_len + face_gap + face_t",
      "unit": "mm",
      "comment": "Derived: rotor pole face",
      "model": false
    },
    {
      "name": "z_arm",
      "expr": "z_pole + engaged_gap",
      "unit": "mm",
      "comment": "Derived: armature pole face (engaged)",
      "model": false
    },
    {
      "name": "z_root",
      "expr": "z_pole - root_drop + tooth_h",
      "unit": "mm",
      "comment": "Derived: armature tooth root level (flanks of the mating teeth meet tooth_h above the rotor's)",
      "model": false
    },
    {
      "name": "z_pitch",
      "expr": "z_root - tooth_h / 2",
      "unit": "mm",
      "comment": "Derived: pitch plane, shared with the rotor (tooth width = gap width = half a pitch there)",
      "model": false
    },
    {
      "name": "z_floor",
      "expr": "z_root + root_relief",
      "unit": "mm",
      "comment": "Derived: root floor of the tooth band",
      "model": false
    },
    {
      "name": "z_tip",
      "expr": "z_root - (tooth_h - tip_trunc)",
      "unit": "mm",
      "comment": "Derived: truncated tooth tips (pointing toward the motor)",
      "model": false
    },
    {
      "name": "d2",
      "expr": "rotor_od",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d3",
      "expr": "armature_bore",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d6",
      "expr": "tooth_r_out + 1 mm",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d7",
      "expr": "tooth_r_in - tooth_runout",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d10",
      "expr": "tooth_r_out",
      "unit": "mm",
      "model": true
    },
    {
      "name": "d11",
      "expr": "tooth_r_in",
      "unit": "mm",
      "model": true
    }
  ],
