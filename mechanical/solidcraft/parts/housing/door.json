{
  "format": "solidcraft/53",
  "name": "door",
  "units": "mm",
  "params": [
    {
      "name": "panel_t",
      "expr": "3 mm",
      "unit": "mm",
      "comment": "printed wall thickness (PETG); 2-4 mm",
      "model": false
    },
    {
      "name": "fit_gap",
      "expr": "0.25 mm",
      "unit": "mm",
      "comment": "per side, housing cavity over the plate edges; 0.1-0.5 mm",
      "model": false
    },
    {
      "name": "x_half",
      "expr": "55 mm",
      "unit": "mm",
      "comment": "plate / housing inner half-width (back wall inside at -x_half, front at +x_half); 45-70 mm",
      "model": false
    },
    {
      "name": "r_long",
      "expr": "12 mm",
      "unit": "mm",
      "comment": "outer radius of the top-back long edge, and size of the 45 deg top-front chamfer; both go with the hood, so 8-13 mm leaves the shell unchanged",
      "model": false
    },
    {
      "name": "r_bottom",
      "expr": "8.5 mm",
      "unit": "mm",
      "comment": "outer radius of the two bottom long edges (the door's rounded edges); panel_t+2 .. 12 mm",
      "model": false
    },
    {
      "name": "plate_top",
      "expr": "43.83098861837907 mm",
      "unit": "mm",
      "comment": "world y of the plate's top edge (feed_unit PLATE_TOP, from the guard and standoffs)",
      "model": false
    },
    {
      "name": "plate_bot",
      "expr": "-153.70883080499217 mm",
      "unit": "mm",
      "comment": "world y of the plate's bottom edge (feed_unit PLATE_BOT, from the module and tray)",
      "model": false
    },
    {
      "name": "w_shell0",
      "expr": "55 mm",
      "unit": "mm",
      "comment": "W of the housing's open rim on the plate edges (plate outer face minus the lap)",
      "model": false
    },
    {
      "name": "plate_out",
      "expr": "63 mm",
      "unit": "mm",
      "comment": "W of the plate's outer face: drawbolt hole at plate_out + 4, tray-tab screws at plate_out - 6",
      "model": false
    },
    {
      "name": "cap_cut",
      "expr": "248 mm",
      "unit": "mm",
      "comment": "W where the end cap starts; the door's far end is the 45 deg scarf W - y = cap_cut - plate_bot under it; 230-260 mm",
      "model": false
    },
    {
      "name": "knuckle_r",
      "expr": "3.5 mm",
      "unit": "mm",
      "comment": "hinge knuckle radius (on a 3 mm steel pin); 3-4 mm",
      "model": false
    },
    {
      "name": "split_y",
      "expr": "plate_bot - panel_t + r_bottom",
      "unit": "mm",
      "comment": "derived: door / shell split, top of the bottom fillets",
      "model": false
    },
    {
      "name": "hinge_x",
      "expr": "-(x_half + panel_t + 0.75 mm)",
      "unit": "mm",
      "comment": "derived: hinge pin axis, 0.75 outside the back wall, on the split line",
      "model": false
    },
    {
      "name": "chamfer_in",
      "expr": "r_long - panel_t * (2 - sqrt(2))",
      "unit": "mm",
      "comment": "derived: inside legs of the housing's top 45 deg chamfers",
      "model": false
    }
  ],
